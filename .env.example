# App registrations (do not put REAL secrets in this file)
TENANT_ID=00000000-0000-0000-0000-000000000000
AGENT_CLIENT_ID=11111111-1111-1111-1111-111111111111
AGENT_CLIENT_SECRET=LOCAL_AGENT_CREDENTIAL_ONLY_NOT_BACKEND
# Entra app registration protecting the gateway MCP endpoint
GATEWAY_CLIENT_ID=22222222-2222-2222-2222-222222222222
GATEWAY_AUDIENCE=api://22222222-2222-2222-2222-222222222222
GATEWAY_APP_ROLE=Gateway.Invoke
# Azure Function Entra resource app registration
BACKEND_CLIENT_ID=33333333-3333-3333-3333-333333333333
BACKEND_AUDIENCE=api://33333333-3333-3333-3333-333333333333
BACKEND_APP_ROLE=Invoice.Read
BACKEND_HOST=https://REPLACE-ME.azurewebsites.net
# Optional HTTPS origin printed by the security collector Bicep deployment
SECURITY_COLLECTOR_HOST=
# Must equal externally reachable URL; use https:// for cloud
MCP_RESOURCE_URL=https://REPLACE-ME.westeurope.azurecontainerapps.io/mcp
GATEWAY_URL=https://REPLACE-ME.westeurope.azurecontainerapps.io
# Deployment settings (ACR Basic carries a recurring cost)
AZ_RESOURCE_GROUP=rg-agentgateway-demo
AZ_LOCATION=westeurope
AZ_ACA_ENV=acae-agentgateway-demo
AZ_CONTAINER_APP=agentgateway-demo
AZ_IDENTITY_NAME=id-agentgateway-demo
# Change to globally unique, lowercase alphanumeric ACR name
AZ_ACR_NAME=REPLACE_WITH_UNIQUE_ACR_NAME
